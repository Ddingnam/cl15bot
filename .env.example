# Reference only: Spring Boot does not automatically load .env files.
# Set these in STS Run Configuration > Environment or Cloud Run.
MATTERMOST_SLASH_TOKEN=replace-with-slash-command-token
NOTION_TOKEN=replace-with-notion-internal-integration-token
NOTION_DATA_SOURCE_ID=replace-with-shared-study-log-data-source-id
NOTION_TITLE_PROPERTY=스터디
# Mattermost user ID = Members page ID (not a Study Log record ID)
NOTION_MEMBER_MAPPINGS=mattermost-user-id=00000000-0000-0000-0000-000000000001
