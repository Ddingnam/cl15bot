# Spring Boot does not automatically load .env files. Set these in STS Environment or Render.
MATTERMOST_SLASH_TOKEN=replace-with-slash-command-token
# JSON object: stable Mattermost user ID -> existing Notion Members name.
MATTERMOST_MEMBER_MAPPINGS={"replace-with-mm-user-id":"정명남"}
NOTION_TOKEN=replace-with-integration-token
NOTION_DATA_SOURCE_ID=replace-with-study-log-data-source-id
NOTION_MEMBERS_DATA_SOURCE_ID=replace-with-members-data-source-id
# Optional; the existing Study Log title column is 스터디.
NOTION_TITLE_PROPERTY=스터디
